<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Unique FileProvider subclass: merger keys providers by class name, so reusing
             androidx.core.content.FileProvider would collide with Tauri's file chooser. -->
        <provider
            android:name="dev.imal.tauri.androidinstaller.InstallerFileProvider"
            android:authorities="${applicationId}.installer.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/installer_file_paths" />
        </provider>
    </application>

</manifest>
