{
  "identifier": "default",
  "description": "Default capabilities for the app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "notification:default",
    "notification:allow-request-permission",
    "notification:allow-is-permission-granted",
    "notification:allow-notify",
    "notification:allow-create-channel",
    "dialog:default",
    "dialog:allow-open",
    "reminder:default",
    "system-bars:default",
    "upload:default",
    "android-installer:default",
    {
      "identifier": "opener:allow-open-url",
      "description": "把指定网址交给系统浏览器：GitHub Release，以及教务同步里的 aTrust 入口。不用 opener:default（它放行所有 http/https 网址）。",
      "allow": [
        { "url": "https://github.com/*" },
        { "url": "https://vpn.haust.edu.cn" },
        { "url": "https://vpn.haust.edu.cn/" },
        { "url": "https://vpn.haust.edu.cn/*" },
        { "url": "https://vpn.haust.edu.cn/**" }
      ]
    },
    {
      "identifier": "http:default",
      "description": "只允许访问学校域名：CAS 认证与教务系统。白名单而不是通配，因为这个权限一旦放开，网页里任何脚本都能借它绕过同源策略发请求。",
      "allow": [
        { "url": "https://cas.haust.edu.cn/*" },
        { "url": "https://jwgl.haust.edu.cn/*" },
        { "url": "https://jwsxy.haust.edu.cn/*" },
        { "url": "https://i.haust.edu.cn/*" }
      ]
    }
  ]
}
