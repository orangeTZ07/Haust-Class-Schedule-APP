{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "自定义课程表",
  "version": "0.1.0",
  "identifier": "com.coursemngr.courseapp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node scripts/patch-android-release-build.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "课程表",
        "width": 400,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:course_mngr.db"]
    }
  }
}
