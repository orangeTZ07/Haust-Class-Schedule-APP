# Dependencies
node_modules/
/dist
/dist-ssr
*.local

# Rust/Tauri Build
src-tauri/target/
src-tauri/gen/
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db
desktop.ini

# Android
*.apk
*.ap_
*.aab
*.dex
*.jks
*.keystore
src-tauri/gen/android/.gradle/
src-tauri/gen/android/build/
src-tauri/gen/android/app/build/
src-tauri/gen/android/local.properties
src-tauri/plugins/**/android/build/
src-tauri/plugins/**/android/.tauri/

# iOS (plugin Swift packages)
# tauri-plugin's build script copies the Tauri iOS API to <plugin>/.tauri/tauri-api, one level
# above ios/, so this pattern is not the same as the android/.tauri one above.
src-tauri/plugins/**/.tauri/
src-tauri/plugins/**/ios/.build/
src-tauri/plugins/**/ios/.swiftpm/
src-tauri/plugins/**/ios/Package.resolved

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Gemini CLI / Agents
.agents/
.codex
.playwright-mcp/
skills-lock.json

# Typescript
*.tsbuildinfo
